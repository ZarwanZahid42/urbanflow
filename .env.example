# Existing ADLS Gen2 resource (non-secret configuration)
AZURE_STORAGE_ACCOUNT_NAME=urbanflowdata2026
AZURE_STORAGE_FILE_SYSTEM=urbanflow

# Azure Databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=

# Snowflake (non-secret identifiers; the private key stays outside the repository)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=URBANFLOW_DATABRICKS_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=URBANFLOW_LOADER_ROLE
SNOWFLAKE_WAREHOUSE=URBANFLOW_LOAD_WH
SNOWFLAKE_DATABASE=URBANFLOW
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_LANDING_SCHEMA=LANDING
SNOWFLAKE_AUDIT_SCHEMA=AUDIT

# Local real-data acquisition
TLC_YEAR=2026
TLC_MONTH=5
TLC_TAXI_TYPE=yellow
DATA_DIR=data

# NOAA/NCEI Climate Data Online API
NOAA_API_TOKEN=
NOAA_STATION_ID=GHCND:USW00094728
NOAA_DATASET_ID=GHCND
NOAA_START_DATE=2026-05-01
NOAA_END_DATE=2026-05-31
NOAA_UNITS=metric
